#. module: ssi_dashboard_item_tile
#: model:ir.model.fields,help:ssi_dashboard_item_tile.field_dashboard_item__tile_layout
msgid ""
"Arrangement the browser renders this tile in. Only used when 'Type' is "
"'Tile'. 'Value With Comparison' requires the 'Data Source''s 'Comparison' to"
" be set. 'Value With Target' requires 'Goal Type' to be set."
msgstr ""

#. module: ssi_dashboard_item_tile
#: model:ir.model.fields,help:ssi_dashboard_item_tile.field_dashboard_item__tile_background_color
msgid ""
"CSS color value used as this tile's background. Only used when 'Type' is "
"'Tile'. Left empty, the dashboard's own '--ssi-dashboard-surface' color "
"scheme variable is used instead."
msgstr ""

#. module: ssi_dashboard_item_tile
#: model:ir.model.fields,help:ssi_dashboard_item_tile.field_dashboard_item__tile_text_color
msgid ""
"CSS color value used for this tile's text. Only used when 'Type' is 'Tile'. "
"Left empty, the dashboard's own '--ssi-dashboard-text' color scheme variable"
" is used instead."
msgstr ""

