#. module: ssi_dashboard_item_tile
#: model:ir.model.fields,help:ssi_dashboard_item_tile.field_dashboard_item__tile_icon
msgid ""
"Font Awesome icon class already bundled with the Odoo backend, e.g. 'fa-"
"shopping-cart'. Only used, and only shown, when 'Type' is 'Tile' and 'Tile "
"Layout' is 'Value With Icon' or 'Value With Background Icon'. Left empty, no"
" icon is rendered."
msgstr ""

