<odoo>
    <record id="dashboard_create_from_template_view_form" model="ir.ui.view">
        <field name="name">dashboard.create.from.template - form</field>
        <field name="model">dashboard.create.from.template</field>
        <field name="arch" type="xml">
            <form string="Create Dashboard from Template">
                <group>
                    <field name="template_id" />
                    <field name="name" />
                    <field name="code" />
                </group>
                <footer>
                    <button
                        name="action_create"
                        string="Create"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        string="Cancel"
                        class="btn btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="dashboard_create_from_template_action" model="ir.actions.act_window">
        <field name="name">Create Dashboard from Template</field>
        <field name="res_model">dashboard.create.from.template</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_dashboard_template" />
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_dashboard_admin')])]" />
    </record>
</odoo>
