<odoo>
    <record id="dashboard_import_view_form" model="ir.ui.view">
        <field name="name">dashboard.import - form</field>
        <field name="model">dashboard.import</field>
        <field name="arch" type="xml">
            <form string="Import Dashboard">
                <group>
                    <field
                        name="data_file"
                        filename="filename"
                        widget="binary"
                        string="Dashboard File"
                    />
                    <field name="filename" invisible="1" />
                    <field name="name_suffix" />
                </group>
                <footer>
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="oe_highlight"
                    />
                    <button string="Cancel" class="btn btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="dashboard_import_action" model="ir.actions.act_window">
        <field name="name">Import Dashboard</field>
        <field name="res_model">dashboard.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
        id="dashboard_import_menu"
        name="Import Dashboard"
        parent="menu_dashboard_configuration"
        action="dashboard_import_action"
        sequence="50"
        groups="ssi_dashboard.group_dashboard_admin"
    />
</odoo>
