<odoo>
    <record id="dashboard_item_move_view_form" model="ir.ui.view">
        <field name="name">dashboard.item.move - form</field>
        <field name="model">dashboard.item.move</field>
        <field name="arch" type="xml">
            <form string="Move / Copy Item(s)">
                <group>
                    <field name="item_ids" widget="many2many_tags" readonly="1" />
                    <field name="operation" widget="radio" />
                    <field name="dashboard_id" />
                </group>
                <footer>
                    <button
                        name="action_apply"
                        string="Apply"
                        type="object"
                        class="oe_highlight"
                    />
                    <button
                        string="Cancel"
                        class="btn btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="dashboard_item_move_action" model="ir.actions.act_window">
        <field name="name">Move / Copy Item(s)</field>
        <field name="res_model">dashboard.item.move</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_dashboard_item" />
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_dashboard_admin')])]" />
    </record>
</odoo>
