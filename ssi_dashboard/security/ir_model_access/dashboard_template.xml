<odoo>
    <record id="dashboard_template_user_access" model="ir.model.access">
        <field name="name">dashboard.template - user</field>
        <field name="model_id" ref="model_dashboard_template" />
        <field name="group_id" ref="group_dashboard_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="dashboard_template_admin_access" model="ir.model.access">
        <field name="name">dashboard.template - admin</field>
        <field name="model_id" ref="model_dashboard_template" />
        <field name="group_id" ref="group_dashboard_admin" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
