<odoo>
    <record id="dashboard_color_scheme_view_search" model="ir.ui.view">
        <field name="name">dashboard.color_scheme - search</field>
        <field name="model">dashboard.color_scheme</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="dashboard_color_scheme_view_list" model="ir.ui.view">
        <field name="name">dashboard.color_scheme - list</field>
        <field name="model">dashboard.color_scheme</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="dashboard_color_scheme_view_form" model="ir.ui.view">
        <field name="name">dashboard.color_scheme - form</field>
        <field name="model">dashboard.color_scheme</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="colors" string="Colors">
                        <field name="color_ids">
                            <list editable="bottom">
                                <field name="key" />
                                <field name="value" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="dashboard_color_scheme_action" model="ir.actions.act_window">
        <field name="name">Color Schemes</field>
        <field name="res_model">dashboard.color_scheme</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="dashboard_color_scheme_menu"
        parent="menu_dashboard_configuration"
        action="dashboard_color_scheme_action"
        sequence="10"
    />
</odoo>
