<odoo>
    <record id="dashboard_dashboard_view_search" model="ir.ui.view">
        <field name="name">dashboard.dashboard - search</field>
        <field name="model">dashboard.dashboard</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="dashboard_dashboard_view_list" model="ir.ui.view">
        <field name="name">dashboard.dashboard - list</field>
        <field name="model">dashboard.dashboard</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="color_scheme_id" optional="show" />
                </xpath>
                <xpath expr="//list" position="inside">
                    <button
                        name="action_open_dashboard"
                        type="object"
                        title="Open Dashboard"
                        icon="fa-external-link"
                    />
                </xpath>
            </data>
        </field>
    </record>

    <record id="dashboard_dashboard_view_form" model="ir.ui.view">
        <field name="name">dashboard.dashboard - form</field>
        <field name="model">dashboard.dashboard</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//header" position="inside">
                    <button
                        name="action_open_dashboard"
                        type="object"
                        string="Open Dashboard"
                        class="btn-primary"
                    />
                </xpath>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="items" string="Items">
                        <field name="item_ids" context="{'active_test': False}">
                            <list editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="type" />
                                <field name="data_source_id" />
                                <field
                                    name="allow_open_records"
                                    optional="hide"
                                    widget="boolean_toggle"
                                />
                                <field
                                    name="allow_export"
                                    optional="hide"
                                    widget="boolean_toggle"
                                />
                                <field name="column_start" optional="hide" />
                                <field name="row_start" optional="hide" />
                                <field name="column_width" />
                                <field name="row_height" />
                                <field name="item_theme" optional="hide" />
                                <field name="goal_type" />
                                <field
                                    name="goal_value"
                                    invisible="goal_type != 'fixed'"
                                />
                                <button
                                    name="action_open_item_goals"
                                    type="object"
                                    title="Configure Goals"
                                    icon="fa-bullseye"
                                    invisible="goal_type != 'dated'"
                                />
                                <field name="active" widget="boolean_toggle" />
                            </list>
                        </field>
                    </page>
                    <page name="filters" string="Filters">
                        <field name="filter_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="filter_type" />
                                <field
                                    name="domain"
                                    invisible="filter_type != 'domain'"
                                />
                                <field
                                    name="field_id"
                                    invisible="filter_type != 'field'"
                                />
                                <field name="default_active" widget="boolean_toggle" />
                            </list>
                        </field>
                    </page>
                    <page name="configuration" string="Configuration">
                        <group name="dashboard_dashboard_configuration">
                            <field name="color_scheme_id" />
                            <field name="group_ids" widget="many2many_tags" />
                            <field name="refresh_interval" />
                            <field name="fullscreen_enabled" />
                        </group>
                        <group name="dashboard_dashboard_menu" string="Menu">
                            <field name="generate_menu" />
                            <field name="menu_name" invisible="not generate_menu" />
                            <field
                                name="parent_menu_id"
                                invisible="not generate_menu"
                            />
                            <field name="menu_sequence" invisible="not generate_menu" />
                            <field
                                name="menu_id"
                                invisible="not generate_menu"
                                readonly="1"
                            />
                            <field
                                name="client_action_id"
                                invisible="not generate_menu"
                                readonly="1"
                            />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="dashboard_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboards</field>
        <field name="res_model">dashboard.dashboard</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- OWL client action rendering the dashboard picked up by
         action_open_dashboard()/_open_dashboard(); the tag below must
         match the key the OWL component registers itself under, see
         static/src/dashboard_action/dashboard_action.esm.js. -->
    <record id="dashboard_dashboard_client_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">ssi_dashboard.dashboard_view</field>
    </record>

    <menuitem
        id="dashboard_dashboard_menu"
        parent="menu_dashboard_root"
        action="dashboard_dashboard_action"
        sequence="10"
    />
</odoo>
