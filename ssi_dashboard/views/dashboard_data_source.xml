<odoo>
    <record id="dashboard_data_source_view_search" model="ir.ui.view">
        <field name="name">dashboard.data_source - search</field>
        <field name="model">dashboard.data_source</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="dashboard_data_source_view_list" model="ir.ui.view">
        <field name="name">dashboard.data_source - list</field>
        <field name="model">dashboard.data_source</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="type" />
                    <field name="model_id" optional="show" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="dashboard_data_source_view_form" model="ir.ui.view">
        <field name="name">dashboard.data_source - form</field>
        <field name="model">dashboard.data_source</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="configuration" string="Configuration">
                        <group name="dashboard_data_source_configuration">
                            <field name="type" />
                            <field name="model_id" />
                            <field
                                name="domain"
                                widget="domain"
                                options="{'model': 'model_id'}"
                            />
                            <field name="measure_field_id" />
                            <field name="aggregate" />
                            <field name="group_by_field_id" />
                            <field name="group_by_field_is_date" invisible="1" />
                            <field
                                name="group_by_granularity"
                                invisible="not group_by_field_is_date"
                            />
                            <field name="limit" />
                            <field name="sort_by" />
                            <field name="sort_order" invisible="sort_by == 'none'" />
                            <field name="fill_temporal" />
                        </group>
                        <group name="dashboard_data_source_date_range">
                            <field name="date_field_id" />
                            <field name="date_range" />
                            <field
                                name="date_start"
                                invisible="date_range != 'custom'"
                            />
                            <field name="date_end" invisible="date_range != 'custom'" />
                        </group>
                    </page>
                    <page name="measures" string="Measures">
                        <field name="measure_ids">
                            <list editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field
                                    name="field_id"
                                    domain="[('model_id', '=', parent.model_id), ('ttype', 'in', ['integer', 'float', 'monetary'])]"
                                />
                                <field name="aggregate" />
                                <field name="name" />
                            </list>
                        </field>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="dashboard_data_source_action" model="ir.actions.act_window">
        <field name="name">Data Sources</field>
        <field name="res_model">dashboard.data_source</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="dashboard_data_source_menu"
        parent="menu_dashboard_configuration"
        action="dashboard_data_source_action"
        sequence="20"
    />
</odoo>
