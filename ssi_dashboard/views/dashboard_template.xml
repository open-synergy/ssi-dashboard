<odoo>
    <record id="dashboard_template_view_search" model="ir.ui.view">
        <field name="name">dashboard.template - search</field>
        <field name="model">dashboard.template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data />
        </field>
    </record>

    <record id="dashboard_template_view_list" model="ir.ui.view">
        <field name="name">dashboard.template - list</field>
        <field name="model">dashboard.template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="source_dashboard_id" optional="show" />
                    <field name="is_predefined" optional="hide" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="dashboard_template_view_form" model="ir.ui.view">
        <field name="name">dashboard.template - form</field>
        <field name="model">dashboard.template</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='active']" position="after">
                    <field name="source_dashboard_id" />
                    <field name="is_predefined" />
                </xpath>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="description" string="Description">
                        <field name="description" nolabel="1" />
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="dashboard_template_action" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">dashboard.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="dashboard_template_menu"
        parent="menu_dashboard_configuration"
        action="dashboard_template_action"
        sequence="15"
    />
</odoo>
