<odoo>
    <!-- Standalone form, opened as a dialog by
         dashboard.item.action_open_item_goals()/_open_item_goals() — the
         dashboard form's 'Items' list is editable="bottom" so a nested
         one2many ('Goals') cannot be edited inline there. -->
    <record id="dashboard_item_view_form" model="ir.ui.view">
        <field name="name">dashboard.item - form</field>
        <field name="model">dashboard.item</field>
        <field name="arch" type="xml">
            <form string="Dashboard Item">
                <sheet>
                    <group name="dashboard_item_goal_header">
                        <field name="name" />
                        <field name="goal_type" />
                        <field name="goal_value" invisible="goal_type != 'fixed'" />
                    </group>
                    <group name="dashboard_item_number_format" string="Number Format">
                        <field name="multiplier" />
                        <field name="number_format" />
                        <field name="precision_digits" />
                        <field name="unit_type" />
                        <field name="currency_id" invisible="unit_type != 'monetary'" />
                        <field name="unit_text" invisible="unit_type != 'custom'" />
                        <field name="unit_position" invisible="unit_type == 'none'" />
                    </group>
                    <group name="dashboard_item_theme" string="Theme">
                        <field name="item_theme" />
                        <field
                            name="item_header_color"
                            invisible="item_theme != 'custom'"
                        />
                        <field
                            name="item_border_color"
                            invisible="item_theme != 'custom'"
                        />
                    </group>
                    <field name="goal_ids">
                        <list editable="bottom">
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="value" />
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
