<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ssi_dashboard.DashboardItem">
        <div
            t-attf-class="o_ssi_dashboard_item{{canOpenRecords ? ' o_ssi_dashboard_item_clickable' : ''}}"
            t-att-style="style + '; ' + themeStyle"
            t-on-click="onContainerClick"
        >
            <div t-if="props.isAdmin or canExport" class="o_ssi_dashboard_item_toolbar">
                <a
                    t-if="canExport"
                    t-att-href="exportXlsxUrl"
                    class="btn btn-sm btn-light o_ssi_dashboard_item_export_xlsx"
                    t-att-title="exportXlsxLabel"
                    t-on-click="onExportClick"
                >
                    <i class="fa fa-file-excel-o" />
                </a>
                <a
                    t-if="canExport"
                    t-att-href="exportCsvUrl"
                    class="btn btn-sm btn-light o_ssi_dashboard_item_export_csv"
                    t-att-title="exportCsvLabel"
                    t-on-click="onExportClick"
                >
                    <i class="fa fa-file-text-o" />
                </a>
                <button
                    t-if="props.isAdmin"
                    type="button"
                    class="btn btn-sm btn-light o_ssi_dashboard_item_edit"
                    t-att-title="editLabel"
                    t-on-click.stop="onEditClick"
                >
                    <i class="fa fa-pencil" />
                </button>
            </div>
            <div t-if="canDrillBack" class="o_ssi_dashboard_item_drilldown_trail">
                <button
                    type="button"
                    class="btn btn-sm btn-link o_ssi_dashboard_item_drilldown_back"
                    t-on-click.stop="goBack"
                >
                    <i class="fa fa-arrow-left" />
                    <t t-esc="backLabel" />
                </button>
                <t t-foreach="drilldownTrail" t-as="crumb" t-key="crumb.index">
                    <a
                        href="#"
                        class="o_ssi_dashboard_item_drilldown_crumb"
                        t-on-click.prevent.stop="() => this.goToLevel(crumb.index)"
                        t-esc="crumb.label"
                    />
                    <span t-if="!crumb_last" class="o_ssi_dashboard_item_drilldown_sep">
                        /
                    </span>
                </t>
            </div>
            <t t-component="Component" item="displayItem" />
        </div>
    </t>
</templates>
