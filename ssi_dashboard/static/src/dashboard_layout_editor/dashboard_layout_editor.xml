<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ssi_dashboard.DashboardLayoutEditor">
        <div class="o_ssi_dashboard_layout_editor">
            <div class="o_ssi_dashboard_layout_editor_toolbar">
                <span class="o_ssi_dashboard_layout_editor_hint" t-esc="hintLabel" />
                <button
                    type="button"
                    class="btn btn-primary o_ssi_dashboard_layout_save"
                    t-on-click="onSaveClick"
                    t-esc="saveLabel"
                />
                <button
                    type="button"
                    class="btn btn-secondary o_ssi_dashboard_layout_cancel"
                    t-on-click="onCancelClick"
                    t-esc="cancelLabel"
                />
            </div>
            <div class="o_ssi_dashboard_grid o_ssi_dashboard_grid_edit" t-ref="grid">
                <div
                    t-foreach="state.layout"
                    t-as="tile"
                    t-key="tile.id"
                    class="o_ssi_dashboard_layout_tile"
                    t-att-style="tileStyle(tile)"
                    t-on-pointerdown="(ev) => this.onTilePointerDown(ev, tile.id)"
                >
                    <span class="o_ssi_dashboard_layout_tile_name" t-esc="tile.name" />
                    <div
                        class="o_ssi_dashboard_layout_resize_handle"
                        t-on-pointerdown="(ev) => this.onResizeHandlePointerDown(ev, tile.id)"
                    />
                </div>
            </div>
        </div>
    </t>
</templates>
