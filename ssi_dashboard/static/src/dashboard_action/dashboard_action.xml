<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="ssi_dashboard.DashboardAction">
        <div class="o_ssi_dashboard" t-att-style="rootStyle" t-ref="root">
            <div class="o_ssi_dashboard_header">
                <h2 class="o_ssi_dashboard_title" t-esc="dashboard.name" />
                <span
                    t-if="state.refreshFailed"
                    class="o_ssi_dashboard_refresh_failed text-danger"
                    t-esc="refreshFailedLabel"
                />
                <div class="o_ssi_dashboard_header_actions">
                    <button
                        type="button"
                        class="btn btn-secondary o_ssi_dashboard_refresh"
                        t-att-disabled="state.isRefreshing"
                        t-on-click="onManualRefreshClick"
                        t-esc="refreshLabel"
                    />
                    <button
                        t-if="state.isAdmin and !state.editMode"
                        type="button"
                        class="btn btn-secondary o_ssi_dashboard_edit_layout"
                        t-on-click="onEditLayoutClick"
                        t-esc="editLayoutLabel"
                    />
                    <button
                        t-if="dashboard.fullscreen_enabled"
                        type="button"
                        class="btn btn-secondary o_ssi_dashboard_fullscreen"
                        t-on-click="onFullscreenClick"
                        t-esc="fullscreenLabel"
                    />
                </div>
            </div>
            <t t-if="!state.editMode">
                <DashboardFilterBar
                    filters="dashboard.filters"
                    activeFilterIds="dashboard.active_filter_ids"
                    onChange.bind="onFilterChange"
                />
                <div class="o_ssi_dashboard_grid" t-ref="grid">
                    <DashboardItem
                        t-foreach="dashboard.items"
                        t-as="item"
                        t-key="item.id"
                        item="item"
                        useExplicitPosition="useExplicitPosition"
                    />
                </div>
            </t>
            <t t-else="">
                <DashboardLayoutEditor
                    items="state.editItems"
                    onSave.bind="onSaveLayoutClick"
                    onCancel.bind="onCancelLayoutClick"
                />
            </t>
        </div>
    </t>
</templates>
