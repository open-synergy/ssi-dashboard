#. module: ssi_dashboard_item_chart
#: model:ir.model.fields,help:ssi_dashboard_item_chart.field_dashboard_item__chart_type
msgid ""
"Kind of chart rendered by the browser. Only used when 'Type' is 'Chart'. "
"'Horizontal Bar' and 'Area' are rendered as Chart.js 'bar'/'line' charts "
"with a client-side option added (horizontal index axis / area fill) — the "
"server sends this value unchanged, the mapping happens in the browser."
msgstr ""

#. module: ssi_dashboard_item_chart
#: model:ir.model.fields,help:ssi_dashboard_item_chart.field_dashboard_item__type
msgid ""
"Kind of tile rendered by the browser. Extension modules add more choices via"
" 'selection_add' and may implement a matching "
"'_prepare_render_payload_<type>' method."
msgstr ""

