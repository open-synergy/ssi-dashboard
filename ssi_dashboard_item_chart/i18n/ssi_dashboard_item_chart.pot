msgstr ""

#. module: ssi_dashboard_item_chart
#: model:ir.model.fields,help:ssi_dashboard_item_chart.field_dashboard_item__chart_stacked
msgid ""
"Stack this chart's datasets on top of each other instead of side by side. "
"Only used when 'Type' is 'Chart' and only supported when 'Chart Type' is "
"'Bar', 'Horizontal Bar' or 'Area'."
msgstr ""

